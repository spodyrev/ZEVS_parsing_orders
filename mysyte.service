[Unit]
Description=MySyte Order Tracking System - Web Application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mysyte
Environment="PATH=/opt/mysyte/venv/bin"
Environment="PYTHONUNBUFFERED=1"

# Запуск приложения
ExecStart=/opt/mysyte/venv/bin/python /opt/mysyte/backend/app.py

# Автоматический перезапуск при падении
Restart=always
RestartSec=10

# Логирование
StandardOutput=append:/var/log/mysyte/app.log
StandardError=append:/var/log/mysyte/app_error.log

# Безопасность
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
