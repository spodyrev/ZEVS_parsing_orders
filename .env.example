# ==================== БАЗА ДАННЫХ ====================
# SQLite для локальной разработки
DATABASE_URL=sqlite:///./orders.db

# Для production с PostgreSQL используйте:
# DATABASE_URL=postgresql://user:password@localhost:5432/mysyte


# ==================== БЕЗОПАСНОСТЬ ====================
# Секретный ключ для JWT токенов (ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ В PRODUCTION!)
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production


# ==================== ВЕБ-СЕРВЕР ====================
# Настройки сервера
HOST=127.0.0.1
PORT=8000

# Режим разработки (в production установите False)
DEBUG=True

# CORS - разрешенные домены (через запятую)
# В production укажите ваш реальный домен!
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# ==================== TELEGRAM ====================
# Telegram Bot Token (для Login Widget и бота склада)
# Получить токен: https://t.me/botfather -> /newbot
# ВАЖНО: Используется для:
#   1. Аутентификации пользователей через Telegram Login Widget
#   2. Работы бота складских операций
TELEGRAM_BOT_TOKEN=your_bot_token_here


# ==================== СИНХРОНИЗАЦИЯ TAOBAO ====================
# Интервал автоматической проверки заказов (в часах)
SYNC_INTERVAL_HOURS=2

# Настройки Taobao (заполнишь после первой авторизации)
# TAOBAO_COOKIES_FILE=cookies.json


# ==================== ЛОГИРОВАНИЕ ====================
# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Файл логов
LOG_FILE=app.log


# ==================== GOOGLE GEMINI (опционально) ====================
# API ключ для переводов через Google Gemini
# Получить: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here


# ==================== PRODUCTION НАСТРОЙКИ ====================
# Раскомментируйте и настройте для production деплоя:

# HOST=0.0.0.0
# PORT=8000
# DEBUG=False
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# DATABASE_URL=postgresql://user:password@localhost:5432/mysyte
